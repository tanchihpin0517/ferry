#!/bin/sh
# A stand-in for ssh: runs everything on this machine. DELAY seconds are
# slept before the command that starts a (non-join) ferry server.
mode=run; sock=
while [ $# -gt 0 ]; do
  case "$1" in
    -G) exit 1 ;;
    -o) shift 2 ;;
    -T) shift ;;
    -N) mode=hold; shift ;;
    -O) mode=check; shift 2 ;;
    -W) mode=fwd; sock=$2; shift 2 ;;
    --) shift; shift; break ;;
    *) shift ;;
  esac
done
case $mode in
  hold) exec sleep 100000 ;;
  check) exit 0 ;;
  fwd) exec python3 -I "$(cd "$(dirname "$0")" && pwd)/fwd.py" "$sock" ;;
esac
case "$1" in
  *"'server'"*"--join"*) ;;
  *"'server'"*) [ -n "$DELAY" ] && sleep "$DELAY" ;;
esac
cd "$HOME" && exec sh -c "$1"
